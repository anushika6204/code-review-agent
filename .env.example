# Copy to .env and fill in. Never commit .env.
GITHUB_TOKEN=ghp_your_token_with_repo_contents_write_scope
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Optional: HMAC secret configured on the GitHub webhook (enables signature checks)
GITHUB_WEBHOOK_SECRET=

# Checkpointer: "sqlite" (persistent, default) or "memory"
CHECKPOINTER=sqlite
SQLITE_PATH=data/checkpoints.sqlite

# Offline demo: fake GitHub + fake LLM, no keys required
MOCK_MODE=false

MAX_REVISIONS=5
MAX_FILES=20
